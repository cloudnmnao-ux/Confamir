{
	auto_https off
	admin off
}
:{$PORT} {
	handle /in2 {
		reverse_proxy 127.0.0.1:10000 {
			flush_interval -1
		}
	}
	handle /vl {
		reverse_proxy 127.0.0.1:10001 {
			flush_interval -1
		}
	}
	handle /tr {
		reverse_proxy 127.0.0.1:10002 {
			flush_interval -1
		}
	}
	handle /hu {
		reverse_proxy 127.0.0.1:10003 {
			flush_interval -1
		}
	}
	handle {
		reverse_proxy 127.0.0.1:8000
	}
}
